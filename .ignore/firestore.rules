rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // must equal CFG.admin + '@' + CFG.domain from config.js
    function admin() {
      return request.auth != null && request.auth.token.email == 'admin@mess.app';
    }
    // a member can read only while their member doc exists and has no end date
    function active() {
      return request.auth != null &&
        get(/databases/$(db)/documents/members/$(request.auth.uid)).data.end == '';
    }
    match /{col}/{id} {
      allow read: if admin() || active();
      allow write: if admin();
    }
  }
}
